<?xml version="1.0" encoding="utf-8"?>
<!-- 纯本地笔记应用：禁止云备份与设备迁移导出（方案 §12 数据面）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
